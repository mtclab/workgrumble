{
  "name": "workgrumble",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "core:test": "cargo test --manifest-path core-rs/Cargo.toml",
    "core:lint": "cargo clippy --manifest-path core-rs/Cargo.toml --all-targets -- -D warnings",
    "core:build": "wasm-pack build core-rs --target web --out-dir pkg",
    "gate:core": "npm run core:test && npm run core:lint && npm run core:build",
    "gate": "npm run gate:core && npm run typecheck && npm run lint && vitest run --maxWorkers=4",
    "gate:seeds": "WG_SEEDS=10000 vitest run --no-file-parallelism src/world/tickets/solvability.test.ts -t \"drawn weeks\"",
    "gate:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
